+- (void)removeCurrentPlaylistItemAndPlayNext
+{
+    intf_thread_t *p_intf = getIntf();
+    if (!p_intf)
+        return;
+
+    playlist_t *p_playlist = pl_Get(p_intf);
+    input_thread_t *p_input = playlist_CurrentInput(p_playlist);
+    if (!p_input)
+        return;
+
+    input_item_t *p_inputItem = input_GetItem(p_input);
+    playlist_Lock(p_playlist);
+
+    playlist_item_t *p_currentItem = playlist_ItemGetByInput(p_playlist, p_inputItem);
+    if (p_currentItem && !(p_currentItem->i_flags & PLAYLIST_RO_FLAG)) {
+        playlist_item_t *p_node = get_current_status_node(p_playlist);
+        playlist_item_t *p_nextItem = NULL;
+        if (p_node) {
+            p_nextItem = playlist_GetNextLeaf(p_playlist, p_node, p_currentItem, true, false);
+            if (!p_nextItem)
+                p_nextItem = playlist_GetNextLeaf(p_playlist, p_node, NULL, true, false);
+            if (p_nextItem == p_currentItem)
+                p_nextItem = NULL;
+        }
+
+        playlist_NodeDelete(p_playlist, p_currentItem);
+        if (p_nextItem)
+            playlist_ViewPlay(p_playlist, p_node, p_nextItem);
+    }
+
+    playlist_Unlock(p_playlist);
+    vlc_object_release(p_input);
 }
 
