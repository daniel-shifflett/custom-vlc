+- (IBAction)trashCurrentFile:(id)sender
+{
+    NSURL *mediaURL = [[VLCCoreInteraction sharedInstance] URLOfCurrentPlaylistItem];
+    if (!mediaURL.isFileURL)
+        return;
+
+    NSString *filename = [[NSFileManager defaultManager] displayNameAtPath:mediaURL.path];
+    NSAlert *alert = [[NSAlert alloc] init];
+    [alert setAlertStyle:NSWarningAlertStyle];
+    [alert setMessageText:_NS("Move file to Trash?")];
+    [alert setInformativeText:[NSString stringWithFormat:_NS("“%@” will be moved to the Trash."), filename]];
+    [alert addButtonWithTitle:_NS("Move to Trash")];
+    [alert addButtonWithTitle:_NS("Cancel")];
+
+    if ([alert runModal] != NSAlertFirstButtonReturn)
+        return;
+
+    if (@available(macOS 10.8, *)) {
+        NSError *error = nil;
+        if ([[NSFileManager defaultManager] trashItemAtURL:mediaURL
+                                         resultingItemURL:nil
+                                                     error:&error]) {
+            [[VLCCoreInteraction sharedInstance] removeCurrentPlaylistItemAndPlayNext];
+            [self updateTrashButton];
+            return;
+        }
+
+        NSAlert *errorAlert = [NSAlert alertWithError:error];
+        [errorAlert runModal];
+        return;
+    }
+
+    NSAlert *unsupportedAlert = [[NSAlert alloc] init];
+    [unsupportedAlert setAlertStyle:NSWarningAlertStyle];
+    [unsupportedAlert setMessageText:_NS("Moving files to Trash is unavailable")];
+    [unsupportedAlert setInformativeText:_NS("This version of macOS does not support moving files to the Trash from VLC.")];
+    [unsupportedAlert addButtonWithTitle:_NS("OK")];
+    [unsupportedAlert runModal];
+}
+
+- (void)updateTrashButton
+{
+    NSURL *mediaURL = [[VLCCoreInteraction sharedInstance] URLOfCurrentPlaylistItem];
+    BOOL hasLocalFile = mediaURL.isFileURL &&
+                        [[NSFileManager defaultManager] fileExistsAtPath:mediaURL.path];
+    [_trashButton setHidden:!hasLocalFile];
+}
